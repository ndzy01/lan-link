{
  "name": "lan-link",
  "version": "0.1.0",
  "type": "module",
  "description": "无信令服务器、双向扫码配对的局域网 WebRTC 数据通信",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "jsqr": "1.4.0"
  },
  "scripts": {
    "dev": "rslib --watch",
    "dev:demo": "pnpm build && vite --host 0.0.0.0 --port 5290 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "rslib",
    "build:demo": "pnpm build && vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "qrcode": "1.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "@rslib/core": "1.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndzy01/lan-link.git"
  },
  "homepage": "https://github.com/ndzy01/lan-link#readme",
  "bugs": {
    "url": "https://github.com/ndzy01/lan-link/issues"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
